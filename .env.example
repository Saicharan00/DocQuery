SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=

# Live Railway base URL, e.g. https://your-app.up.railway.app
NEXT_PUBLIC_API_URL=

# Comma-separated browser origins allowed to call the API.
# Day 4: append the Vercel URL here.
CORS_ORIGINS=

# Cohere — embeddings only (embed-v4.0). Chat models go through LiteLLM.
COHERE_API_KEY=

# Chat models, via LiteLLM. Both optional: the API boots with either one alone and
# rejects a request naming the unconfigured provider. Gemini is the default model.
GEMINI_API_KEY=
OPENAI_API_KEY=
