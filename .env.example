SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=

# Live Railway base URL, e.g. https://your-app.up.railway.app
NEXT_PUBLIC_API_URL=

# Comma-separated browser origins allowed to call the API.
# Day 4: append the Vercel URL here.
CORS_ORIGINS=

# Cohere — embeddings only (embed-v4.0). Chat models go through LiteLLM.
COHERE_API_KEY=

# Chat models, via LiteLLM. Both optional: the API boots with either one alone and
# rejects a request naming the unconfigured provider. Gemini is the default model.
GEMINI_API_KEY=
OPENAI_API_KEY=

# LangSmith — Day 10a tracing. All four optional: with LANGSMITH_TRACING unset or
# false the app runs exactly as before and sends nothing. Free tier, no card.
#
# The SDK reads these from the real environment only, so app/services/tracing.py
# copies them across at import time — pydantic-settings loads this file into
# Settings but never exports to os.environ. Without that copy, tracing would work
# on Railway and silently do nothing locally.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
# Groups traces in the dashboard. Anything; it is created on first trace.
LANGSMITH_PROJECT=
# Only matters if the account is in the EU — the SDK defaults to the US host, and
# an EU account pointed at it authenticates fine and lands the traces nowhere.
# Whatever smith.langchain.com shows you.
LANGSMITH_ENDPOINT=
