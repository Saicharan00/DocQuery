# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Machine-local Claude Code state: per-machine settings and scratch worktrees.
.claude/settings.local.json
.claude/worktrees/

# Real secrets — never commit. Keys live here at runtime.
.env
.env.local
.env.*.local
.env.production
.env.development
# ...but DO commit the empty-placeholder template.
!.env.example


# Throwaway output from scripts/inspect_images.py.
crops/

# scripts/backfill_captions.py's working files: base64 copies of real
# uploaded document images plus their captions, not metrics like eval_cache/.
scripts/backfill_cache/

# Output of scripts/smoke_test_caption.py and scripts/backfill_captions.py's
# manual test runs.
scripts/*_out*.txt
scripts/*_check.txt
